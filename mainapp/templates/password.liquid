# vinted_sniper_bot.py
import discord, requests, asyncio
from bs4 import BeautifulSoup

TOKEN = 'MTM4MTA3MDgxMTMzMDUxNTA5Ng.GIQgET.X393Xw7bmcnh1g1mxATDgPP465D2Iu4YRqEvuQ'
CHANNEL_ID = 1234567890  # Channel ID

intents = discord.Intents.default()
client = discord.Client(intents=intents)

def snipe(keyword, max_price):
    url = f"https://www.vinted.de/vetements?search_text={keyword}&price_to={max_price}"
    headers = {"User-Agent": "Mozilla/5.0"}
    soup = BeautifulSoup(requests.get(url, headers=headers).text, 'html.parser')
    items = soup.find_all("div", class_="feed-grid__item")
    results = []
    for item in items[:3]:
        try:
            title = item.find("h3").text
            price = item.find("span", class_="web_ui__Text__text").text
            link = "https://vinted.de" + item.find("a")["href"]
            results.append((title, price, link))
        except: continue
    return results

@client.event
async def on_ready():
    print(f"✅ Eingeloggt als {client.user}")
    ch = client.get_channel(CHANNEL_ID)
    while True:
        for title, price, link in snipe("nike", 30):
            await ch.send(f"**{title}** | {price}\n{link}")
        await asyncio.sleep(600)  # alle 10 Minuten

client.run(TOKEN)     